#!/bin/sh /etc/rc.common
# OpenWrt procd 初始化脚本 —— hebing
# 启动：/etc/init.d/hebing start   停止：/etc/init.d/hebing stop
# 开机自启：/etc/init.d/hebing enable   取消：/etc/init.d/hebing disable

START=99
STOP=15
USE_PROCD=1

NAME=hebing
CONFIG_NAME=hebing

load_config() {
	config_load "$CONFIG_NAME"
	config_get_bool enabled main enabled 1
	config_get app_home main app_home "/usr/lib/hebing"
	config_get data_dir main data_dir "/etc/hebing/data"
	config_get listen_host main listen_host "0.0.0.0"
	config_get listen_port main listen_port "8080"
}

validate_port() {
	case "$2" in
		''|*[!0-9]*) echo "$NAME: 无效端口: $2" >&2; return 1 ;;
	esac
	[ "$2" -ge 1 ] && [ "$2" -le 65535 ] || { echo "$NAME: 端口越界: $2" >&2; return 1; }
}

start_service() {
	load_config
	[ "$enabled" = "1" ] || return 0

	validate_port listen_port "$listen_port" || return 1

	mkdir -p "$data_dir"

	local bin="$app_home/bin/hebing"
	[ -x "$bin" ] || { echo "$NAME: 二进制不可执行: $bin" >&2; return 1; }

	procd_open_instance
	procd_set_param command "$bin" \
		-listen "$listen_host:$listen_port" \
		-data "$data_dir"
	procd_set_param env \
		"PATH=/usr/sbin:/usr/bin:/sbin:/bin" \
		"TZ=${TZ:-Asia/Shanghai}" \
		"HEBING_DATA_DIR=$data_dir"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	logger -t "$NAME" "stop requested"
}

reload_service() {
	logger -t "$NAME" "reload requested"
	stop
	sleep 1
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONFIG_NAME"
}
